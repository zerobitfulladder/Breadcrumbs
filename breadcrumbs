#!/usr/bin/env python3
"""Build and run Breadcrumbs.

Standard library only, and it must stay that way: the first thing anyone runs
is `install`, which is what creates the environments the rest depends on.

    ./breadcrumbs --help
    ./breadcrumbs dev
"""
from __future__ import annotations

import argparse
import fcntl
import http.client
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
import webbrowser
from pathlib import Path

SCRIPT = Path(__file__).resolve()
ROOT = SCRIPT.parent
BACKEND = ROOT / "backend"
FRONTEND = ROOT / "frontend"
DIST = FRONTEND / "dist"
PAGES = Path(os.environ.get("PAGES", "site"))
ICON = FRONTEND / "public" / "favicon.svg"

HOST = os.environ.get("HOST", "127.0.0.1")
PORT = os.environ.get("PORT", "8000")

UV = ["uv", "run", "--project", str(BACKEND)]

# Where `open` leaves the background server's pid and output. The runtime
# directory is emptied at logout, so a pid read from it cannot be one left over
# from an earlier session and since handed to some other program.
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "breadcrumbs"
PIDFILE = RUNTIME / "server.pid"
LOG = RUNTIME / "server.log"

APPLICATIONS = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "applications"


class Failed(SystemExit):
    """A step exited non-zero. Reported without a traceback."""


def run(cmd: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> None:
    """Run a command, echoing it first, and stop the whole script if it fails."""
    print(f"$ {' '.join(cmd)}", flush=True)
    result = subprocess.run(cmd, cwd=cwd or ROOT, env={**os.environ, **(env or {})})
    if result.returncode:
        raise Failed(result.returncode)


def need(tool: str, why: str) -> None:
    if shutil.which(tool) is None:
        raise Failed(f"{tool} is not installed, and {why}.")


def notify(message: str, *, urgent: bool = False) -> None:
    """Show a desktop notification, where there is anything to show it."""
    if shutil.which("notify-send") is None:
        return
    urgency = ["--urgency=critical"] if urgent else []
    try:
        subprocess.run(
            ["notify-send", "--app-name=Breadcrumbs", f"--icon={ICON}", *urgency,
             "Breadcrumbs", message],
            check=False, timeout=5,
        )
    except subprocess.TimeoutExpired:
        pass


def tell(args: argparse.Namespace, message: str) -> None:
    """Print a result, and with --notify show it on the desktop as well."""
    print(message)
    if getattr(args, "notify", False):
        notify(message)


def listening(host: str, port: str) -> bool:
    """Whether anything at all accepts connections on host:port."""
    try:
        with socket.create_connection((host, int(port)), timeout=0.5):
            return True
    except OSError:
        return False


def serving(host: str, port: str) -> bool:
    """Whether Breadcrumbs, and not just anything, answers on host:port."""
    try:
        with urllib.request.urlopen(f"http://{host}:{port}/api/settings", timeout=2) as response:
            return response.status == 200
    except (OSError, http.client.HTTPException):
        return False


def background_pid() -> int | None:
    """The pid of the server `open` started, if it is still running."""
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return None
    # Belt and braces over the runtime directory: a server killed from outside
    # leaves its pid file behind, and `stop` signalling whatever took the pid
    # next would be a nasty surprise. Only checkable where there is a /proc.
    if Path("/proc/self").is_dir():
        try:
            if os.fsencode(str(SCRIPT)) not in Path(f"/proc/{pid}/cmdline").read_bytes():
                return None
        except OSError:
            return None
    return pid


def claim_port(host: str, port: str) -> None:
    """Stop before starting a server, and say why, if the port is taken."""
    if not listening(host, port):
        return
    if background_pid() is not None:
        raise Failed(
            f"Breadcrumbs is already running in the background on port {port}.\n"
            "Stop it first: ./breadcrumbs stop"
        )
    raise Failed(f"Port {port} is already in use.")


# --- commands ---------------------------------------------------------------


def cmd_install(args: argparse.Namespace) -> None:
    """Install backend and frontend dependencies."""
    need("uv", "the backend needs it")
    need("npm", "the frontend bundle is built with it")
    run(["uv", "sync", "--project", str(BACKEND)])
    run(["npm", "ci"], cwd=FRONTEND)


def frontend_is_stale() -> bool:
    """Whether any frontend source is newer than the built bundle."""
    built = DIST / "index.html"
    if not built.is_file():
        return True
    newest = max(
        (p.stat().st_mtime for p in [
            *(FRONTEND / "src").rglob("*"),
            FRONTEND / "index.html",
            FRONTEND / "package.json",
            FRONTEND / "vite.config.ts",
        ] if p.is_file()),
        default=0.0,
    )
    return newest > built.stat().st_mtime


def cmd_build(args: argparse.Namespace) -> None:
    """Build the frontend bundle, if anything changed."""
    if not args.force and not frontend_is_stale():
        print("bundle is up to date")
        return
    # VITE_API_BASE is emptied on purpose: the bundle then calls /api/... on
    # whatever origin served it, so one build works on any host or port. The
    # default is an absolute 127.0.0.1:8000, which only suits the dev server.
    run(["npm", "run", "build"], cwd=FRONTEND, env={"VITE_API_BASE": ""})


def cmd_serve(args: argparse.Namespace) -> None:
    """Serve the existing build from the backend alone."""
    if not (DIST / "index.html").is_file():
        raise Failed("No bundle yet. Run: ./breadcrumbs build")
    claim_port(args.host, args.port)
    print(f"Breadcrumbs on http://{args.host}:{args.port}")
    run([*UV, "uvicorn", "backend.api:app", "--host", args.host, "--port", str(args.port)])


def cmd_run(args: argparse.Namespace) -> None:
    """Build, then serve everything from the backend alone."""
    cmd_build(argparse.Namespace(force=False))
    cmd_serve(args)


def start_in_background(args: argparse.Namespace) -> None:
    """Start the server unless it is already answering, and wait until it does."""
    if serving(args.host, args.port):
        return
    if background_pid() is not None:
        # Started by an earlier `open` that gave up waiting for it. A second
        # server would only fail to bind.
        def alive() -> bool:
            return background_pid() is not None
    elif listening(args.host, args.port):
        raise Failed(f"Port {args.port} is in use by something other than Breadcrumbs.")
    else:
        with LOG.open("w") as log:
            # `run` rather than uvicorn directly, so a checkout changed since
            # the last build is rebuilt first. Its own session, so it outlives
            # this command and the launcher that ran it, and so `stop` can
            # signal the whole group: this script, uv, and uvicorn.
            server = subprocess.Popen(
                [sys.executable, str(SCRIPT), "run", "--host", args.host, "--port", str(args.port)],
                cwd=ROOT, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                start_new_session=True, env={**os.environ, "PYTHONUNBUFFERED": "1"},
            )
        PIDFILE.write_text(str(server.pid))

        def alive() -> bool:
            return server.poll() is None

    deadline = time.monotonic() + 60
    while not serving(args.host, args.port):
        if not alive():
            PIDFILE.unlink(missing_ok=True)
            raise Failed(f"Breadcrumbs stopped while starting. Its output is in {LOG}")
        if time.monotonic() > deadline:
            raise Failed(f"Breadcrumbs has not answered after a minute. Its output is in {LOG}")
        time.sleep(0.3)


def cmd_open(args: argparse.Namespace) -> None:
    """Open Breadcrumbs in the browser, starting it in the background if it is not running."""
    RUNTIME.mkdir(parents=True, exist_ok=True)
    # Two clicks in quick succession would otherwise both find nothing running
    # and both start a server. The pid file would then name only the second,
    # which exits at once on the taken port, leaving `stop` blind to the first.
    # Serialised, the second waits here and then finds the first one answering.
    with (RUNTIME / "open.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        start_in_background(args)

    url = f"http://{args.host}:{args.port}"
    if not webbrowser.open(url):
        raise Failed(f"Could not start a browser. Breadcrumbs is on {url}")
    print(f"Breadcrumbs on {url}")


def cmd_stop(args: argparse.Namespace) -> None:
    """Stop the server that `open` started in the background."""
    pid = background_pid()
    PIDFILE.unlink(missing_ok=True)
    if pid is None:
        tell(args, "Breadcrumbs was not running in the background.")
        return

    def alive() -> bool:
        try:
            os.killpg(pid, 0)
            return True
        except ProcessLookupError:
            return False

    os.killpg(pid, signal.SIGTERM)
    deadline = time.monotonic() + 10
    while alive() and time.monotonic() < deadline:
        time.sleep(0.2)
    if alive():
        os.killpg(pid, signal.SIGKILL)
    tell(args, "Breadcrumbs stopped.")


def cmd_shortcut(args: argparse.Namespace) -> None:
    """Add app menu entries that open and stop Breadcrumbs.

    They hold this checkout's path, so run it again after moving the checkout.
    """
    entries = {
        APPLICATIONS / "breadcrumbs.desktop":
            ("Start Breadcrumbs", "Open your library, starting it if needed", "open"),
        APPLICATIONS / "breadcrumbs-stop.desktop":
            ("Stop Breadcrumbs", "Stop the Breadcrumbs server running in the background", "stop"),
    }
    if args.remove:
        for path in entries:
            if path.exists():
                path.unlink()
                print(f"removed {path}")
        return

    APPLICATIONS.mkdir(parents=True, exist_ok=True)
    for path, (name, comment, command) in entries.items():
        # --notify because a launcher has no terminal: without it a failure,
        # or stop's result, would be printed to nowhere.
        path.write_text(
            "[Desktop Entry]\n"
            "Type=Application\n"
            f"Name={name}\n"
            f"Comment={comment}\n"
            f'Exec="{SCRIPT}" {command} --notify\n'
            f"Icon={ICON}\n"
            "Terminal=false\n"
            "Categories=Education;\n"
        )
        print(f"wrote {path}")


def cmd_dev(args: argparse.Namespace) -> None:
    """Backend and Vite together, with reload on both."""
    claim_port(args.host, args.port)
    print(f"backend  http://{args.host}:{args.port}")
    print("frontend http://localhost:5173   <- open this one")
    if (PAGES / "index.html").is_file():
        print("readonly http://localhost:5173/readonly/   (published copy; ./breadcrumbs pages)")
    else:
        print("readonly not built yet, run: ./breadcrumbs pages")
    print()

    backend = subprocess.Popen(
        [*UV, "uvicorn", "backend.api:app", "--host", args.host, "--port", str(args.port),
         "--reload", "--reload-dir", str(BACKEND / "src")],
        cwd=ROOT,
    )
    frontend = subprocess.Popen(["npm", "run", "dev"], cwd=FRONTEND)

    # One dying should take the other with it: a backend that failed to bind
    # leaves a Vite serving a page whose every request fails, which looks like
    # a broken app rather than a stopped one.
    try:
        while True:
            for proc in (backend, frontend):
                if proc.poll() is not None:
                    return
            time.sleep(0.3)
    except KeyboardInterrupt:
        pass
    finally:
        for proc in (frontend, backend):
            if proc.poll() is None:
                proc.send_signal(signal.SIGINT)
        for proc in (frontend, backend):
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()


def cmd_dev_backend(args: argparse.Namespace) -> None:
    """Backend only, with reload."""
    claim_port(args.host, args.port)
    run([*UV, "uvicorn", "backend.api:app", "--host", args.host, "--port", str(args.port),
         "--reload", "--reload-dir", str(BACKEND / "src")])


def cmd_dev_frontend(args: argparse.Namespace) -> None:
    """Vite dev server only."""
    run(["npm", "run", "dev"], cwd=FRONTEND)


def cmd_pages(args: argparse.Namespace) -> None:
    """Build a read-only copy of the library for static hosting."""
    out = Path(args.out)
    if out.exists():
        shutil.rmtree(out)

    export = [*UV, "python", "-m", "backend.export_static", "--out", str(out / "data")]
    if args.with_works:
        export.append("--with-works")
    run(export)

    # Stamped onto the export's URLs by the client. Vite content-hashes the
    # scripts and styles, so those are safe to publish over; the data files
    # keep their names from build to build, and a host that told the browser
    # to cache them — GitHub Pages says ten minutes — will hand a returning
    # visitor the last build's library under the new build's code. That reads
    # as a publish that dropped the statuses and stars set since.
    stamp = time.strftime("%Y%m%d%H%M%S")

    # A relative base so the result works from a project page as happily as
    # from a domain root, and VITE_STATIC to point the client at the export.
    run(
        ["npx", "vite", "build", "--base", "./", "--outDir", str((ROOT / out).resolve()),
         "--emptyOutDir", "false"],
        cwd=FRONTEND,
        env={"VITE_API_BASE": "", "VITE_STATIC": "1", "VITE_STATIC_BASE": "./data",
             "VITE_STATIC_VERSION": stamp},
    )

    (out / ".nojekyll").touch()
    # Put back the marker this command's own rmtree removed: the directory is
    # tracked, its contents are not, and dev looks here for the published copy.
    (out / ".gitkeep").touch()

    size = sum(p.stat().st_size for p in out.rglob("*") if p.is_file())
    print()
    print(f"  {out}/ is ready to publish, {size / 1_048_576:.0f} MB")
    print(f"  Preview it with:  python3 -m http.server -d {out} 8080")


def cmd_check(args: argparse.Namespace) -> None:
    """Typecheck the frontend, import the backend, and run the backend tests."""
    # `tsc --noEmit` on the root tsconfig checks nothing: it is a
    # references-only file with "files": [], so tsc has no inputs and exits 0
    # regardless. `-b` builds the referenced projects, which is what typechecks.
    run(["npx", "tsc", "-b", "--force"], cwd=FRONTEND)
    run([*UV, "python", "-c", "from backend.api import app; print('backend imports clean')"])
    run(["uv", "run", "--project", str(BACKEND), "pytest", "-q", str(BACKEND / "tests")])


def cmd_clean(args: argparse.Namespace) -> None:
    """Remove build output and Python caches."""
    for path in (DIST, ROOT / PAGES):
        if path.exists():
            shutil.rmtree(path)
            print(f"removed {path.relative_to(ROOT)}")
    for cache in BACKEND.rglob("__pycache__"):
        shutil.rmtree(cache, ignore_errors=True)


def cmd_wipe(args: argparse.Namespace) -> None:
    """Also remove installed dependencies."""
    cmd_clean(args)
    for path in (FRONTEND / "node_modules", BACKEND / ".venv"):
        if path.exists():
            shutil.rmtree(path)
            print(f"removed {path.relative_to(ROOT)}")


def maintenance(module: str):
    """Wrap a backend maintenance module, passing its own flags straight through."""
    def command(args: argparse.Namespace) -> None:
        run([*UV, "python", "-m", f"backend.{module}", *args.rest])
    return command


# --- argument parsing -------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="./breadcrumbs",
        description="Build and run Breadcrumbs, a local literature study tool.",
        epilog=(
            f"Library:  {os.environ.get('BREADCRUMBS_HOME', '~/Breadcrumbs')}\n"
            "Override: HOST, PORT and PAGES are read from the environment,\n"
            "          or pass --host and --port where a command takes them."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = parser.add_subparsers(dest="command", metavar="<command>", required=True)

    def add(name: str, fn, help_text: str, *, serves: bool = False):
        sub = subs.add_parser(name, help=help_text, description=fn.__doc__)
        if serves:
            sub.add_argument("--host", default=HOST)
            sub.add_argument("--port", default=PORT)
        sub.set_defaults(fn=fn)
        return sub

    add("install", cmd_install, "install backend and frontend dependencies")
    add("dev", cmd_dev, "backend and Vite together, with reload", serves=True)
    add("dev-backend", cmd_dev_backend, "backend only, with reload", serves=True)
    add("dev-frontend", cmd_dev_frontend, "Vite dev server only")
    add("run", cmd_run, "build, then serve everything from the backend", serves=True)
    add("serve", cmd_serve, "serve the existing build, no rebuild", serves=True)

    notify_help = "also report through a desktop notification, for launchers with no terminal"
    opener = add("open", cmd_open, "open in the browser, starting in the background if needed",
                 serves=True)
    opener.add_argument("--notify", action="store_true", help=notify_help)
    stop = add("stop", cmd_stop, "stop the server that open started")
    stop.add_argument("--notify", action="store_true", help=notify_help)
    shortcut = add("shortcut", cmd_shortcut, "add Start Breadcrumbs and Stop Breadcrumbs to the app menu")
    shortcut.add_argument("--remove", action="store_true", help="take them out again")

    build = add("build", cmd_build, "build the frontend bundle if it is stale")
    build.add_argument("--force", action="store_true", help="rebuild even if unchanged")

    pages = add("pages", cmd_pages, "build a read-only copy for static hosting")
    pages.add_argument("--out", default=str(PAGES), help=f"output directory (default: {PAGES})")
    pages.add_argument(
        "--with-works",
        action="store_true",
        help="also fetch each author's wider output from OpenAlex (slow, needs a network)",
    )

    for name, module, help_text in (
        ("backfill", "backfill", "re-fetch every paper's full reference list, then relink"),
        ("redate", "redate", "fix years taken from a reprint or digitised deposit"),
        ("dedupe-authors", "dedupe_authors", "merge author rows that are the same person"),
        ("index", "passages", "cut stored PDFs into passages and embed them for search"),
        ("eval", "evals", "score the assistant on eval/questions.json (see eval/README.md)"),
    ):
        sub = subs.add_parser(name, help=help_text)
        sub.add_argument("rest", nargs=argparse.REMAINDER, help="passed to the module (--dry-run …)")
        sub.set_defaults(fn=maintenance(module))

    add("check", cmd_check, "typecheck the frontend, import the backend, run its tests")
    add("clean", cmd_clean, "remove build output and Python caches")
    add("wipe", cmd_wipe, "also remove installed dependencies")
    return parser


def main() -> None:
    args = build_parser().parse_args()
    try:
        args.fn(args)
    except Failed as exc:
        if isinstance(exc.code, str):
            if getattr(args, "notify", False):
                notify(exc.code, urgent=True)
            print(exc.code, file=sys.stderr)
            raise SystemExit(1) from None
        raise
    except KeyboardInterrupt:
        raise SystemExit(130) from None


if __name__ == "__main__":
    main()
